# Template de configuration - COPIER vers .env et REMPLIR avec vos valeurs

# Database Configuration
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/smartretail

# Docker PostgreSQL Configuration
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=smartretail

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# API Configuration (optionnel)
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Security (générer avec: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here
