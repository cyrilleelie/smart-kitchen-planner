# Template de configuration - COPIER vers .env et REMPLIR avec vos valeurs

# Database Configuration (Application)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://user:password@localhost:5432/smartretail

# Docker PostgreSQL Configuration (Used by docker-compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=smartretail

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# API Configuration (optionnel)
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Security (générer avec: openssl rand -hex 32)
SECRET_KEY=change_me_in_production

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8501
